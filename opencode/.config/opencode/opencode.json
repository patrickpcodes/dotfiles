{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "autoupdate": false,
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers":{
        "Authorization": "Bearer {file:~/.local/share/opencode/secrets/linear-api-key}"
      }
    }
  }
}
